[
  {
    "text": "Carrots in three minutes.",
    "startMs": 260.0,
    "endMs": 1639.0000000000002,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Sweet, crunchy roots, straight from your own",
    "startMs": 2439.0,
    "endMs": 6019.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "garden. Here's how to sow them, look",
    "startMs": 5959.000000000001,
    "endMs": 9138.999999999998,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "after them, and bring in the harvest.",
    "startMs": 9098.999999999998,
    "endMs": 11638.999999999998,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Choose a sunny spot with loose, well-drained",
    "startMs": 12452.333333333332,
    "endMs": 14992.333333333332,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "soil. Remove stones and break up hard",
    "startMs": 14992.33333333333,
    "endMs": 17913.333333333332,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "lumps. Skip fresh manure, which can encourage",
    "startMs": 17872.33333333333,
    "endMs": 21612.333333333332,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "forked roots. On heavy or shallow ground,",
    "startMs": 21592.333333333332,
    "endMs": 24212.333333333332,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "choose a short-rooted variety.",
    "startMs": 24452.333333333332,
    "endMs": 25952.333333333332,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "For a straightforward UK crop, sow from",
    "startMs": 26699.0,
    "endMs": 29159.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "April to June, once the soil is",
    "startMs": 29080.000000000004,
    "endMs": 31180.000000000004,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "workable and warming.",
    "startMs": 31080.000000000004,
    "endMs": 32160.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Early varieties can go under cover in",
    "startMs": 32499.000000000004,
    "endMs": 34279.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "March. Sow another small batch every few",
    "startMs": 34179.0,
    "endMs": 36439.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "weeks for a longer harvest.",
    "startMs": 36319.0,
    "endMs": 37580.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Water a shallow drill, then scatter seed",
    "startMs": 38339.0,
    "endMs": 41080.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "thinly, about one centimetre deep.",
    "startMs": 41019.0,
    "endMs": 43179.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Leave fifteen to thirty centimetres between rows.",
    "startMs": 43819.0,
    "endMs": 46320.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Cover lightly and firm gently.",
    "startMs": 46879.0,
    "endMs": 49019.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Sow direct: transplanting can damage the developing",
    "startMs": 48919.0,
    "endMs": 52039.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "root.",
    "startMs": 51998.99999999999,
    "endMs": 52340.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Germination can take around two to three",
    "startMs": 53138.99999999999,
    "endMs": 54819.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "weeks, longer in cold soil.",
    "startMs": 54798.99999999999,
    "endMs": 56739.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Keep the seed zone moist, without waterlogging",
    "startMs": 57199.0,
    "endMs": 59878.99999999999,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "it. Watch for slugs while seedlings are",
    "startMs": 59798.99999999999,
    "endMs": 62819.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "small, and remove weeds before they take",
    "startMs": 62739.0,
    "endMs": 65319.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "over.",
    "startMs": 65279.0,
    "endMs": 65640.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Thin only crowded seedlings, leaving five to",
    "startMs": 66460.00000000001,
    "endMs": 69079.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "eight centimetres between plants.",
    "startMs": 68979.00000000001,
    "endMs": 70659.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Work gently in damp conditions, remove the",
    "startMs": 71119.00000000001,
    "endMs": 73279.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "thinnings, and firm the soil around the",
    "startMs": 73179.0,
    "endMs": 75080.00000000001,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "plants you keep.",
    "startMs": 75019.0,
    "endMs": 75799.0,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Avoid bruising the foliage.",
    "startMs": 76660.00000000001,
    "endMs": 78039.00000000001,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Once established, water deeply during prolonged dry",
    "startMs": 78945.66666666669,
    "endMs": 82245.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "spells. Pots need checking more often.",
    "startMs": 82225.66666666669,
    "endMs": 84925.66666666669,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "A drought followed by a sudden soaking",
    "startMs": 85425.66666666667,
    "endMs": 87366.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "can split roots.",
    "startMs": 87286.66666666667,
    "endMs": 88265.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Weed carefully by hand close to the",
    "startMs": 88546.66666666669,
    "endMs": 90345.66666666669,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "carrots, keeping disturbance to a minimum.",
    "startMs": 90265.66666666667,
    "endMs": 92465.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Carrot fly larvae tunnel into the roots.",
    "startMs": 93272.33333333334,
    "endMs": 95632.33333333333,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Cover the whole crop with fine insect",
    "startMs": 96472.33333333334,
    "endMs": 98552.33333333333,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "mesh, securing every edge.",
    "startMs": 98512.33333333333,
    "endMs": 100352.33333333333,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Replace it straight after weeding or thinning,",
    "startMs": 100952.33333333334,
    "endMs": 103132.33333333333,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "and avoid ground where carrots were recently",
    "startMs": 103852.33333333333,
    "endMs": 106052.33333333333,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "grown.",
    "startMs": 106033.33333333333,
    "endMs": 106452.33333333334,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Harvest when the roots are big enough",
    "startMs": 107305.66666666667,
    "endMs": 108865.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "to eat, usually twelve to sixteen weeks",
    "startMs": 108765.66666666666,
    "endMs": 111245.66666666666,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "after sowing. Baby carrots may be ready",
    "startMs": 111205.66666666667,
    "endMs": 113485.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "around eight weeks.",
    "startMs": 113385.66666666667,
    "endMs": 114465.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Start at one end of the row;",
    "startMs": 115325.66666666666,
    "endMs": 116705.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "loosen hard soil with a fork before",
    "startMs": 117505.66666666667,
    "endMs": 119585.66666666666,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "pulling.",
    "startMs": 119585.66666666667,
    "endMs": 120005.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Enjoy some freshly pulled.",
    "startMs": 120826.66666666667,
    "endMs": 122225.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "For storage, lift before hard frost or",
    "startMs": 122645.66666666667,
    "endMs": 126065.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "prolonged wet weather.",
    "startMs": 126025.66666666667,
    "endMs": 127125.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Trim the leaves and pack sound roots",
    "startMs": 127825.66666666666,
    "endMs": 129925.66666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "in sand in a cool, airy place.",
    "startMs": 129845.66666666666,
    "endMs": 131865.66666666666,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Check regularly and remove any that rot.",
    "startMs": 132465.66666666666,
    "endMs": 134945.6666666667,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "Good soil, thin sowing, steady moisture, and",
    "startMs": 135732.33333333334,
    "endMs": 139192.33333333334,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "mesh. That's carrots in three minutes.",
